      "group": "learn",
      "kind": "idiom",
      "language": "zh",
      "level": "HSK 3",
      "text": "对牛弹琴",
      "reading": "duì niú tán qín",
      "meaning": "play a zither to a cow",
      "literalMeaning": "To explain something to someone who cannot appreciate or understand it.",
      "whenToUse": "Often used humorously when an explanation is not reaching its audience.",
      "source": "Original Rhiye starter content",
      "tags": [
        "starter",
        "beginner"
      ]
    },
    {
      "id": "zh-idiom-005",
      "group": "learn",
      "kind": "idiom",
      "language": "zh",
      "level": "HSK 3",
      "text": "井底之蛙",
      "reading": "jǐng dǐ zhī wā",
      "meaning": "a frog at the bottom of a well",
      "literalMeaning": "Someone with a very limited view of the world.",
      "whenToUse": "Used as a caution about narrow experience; it can sound critical.",
      "source": "Original Rhiye starter content",
      "tags": [
        "starter",
        "beginner"
      ]
    },
